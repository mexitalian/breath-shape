{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breathing",
  "version": "0.1.0",
  "identifier": "com.mexitalian.breathing",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Breathing",
        "width": 400,
        "height": 640,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "HealthcareAndFitness",
    "shortDescription": "Guided breathing in your menu bar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
